rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // profilePictures/{uid}.jpg
    match /profilePictures/{fileName} {
      allow read, write: if request.auth != null && fileName == request.auth.uid + '.jpg';
    }

    // Stat-sheet photo backups from Zuno chat.
    match /users/{userId}/{allPaths=**} {
      allow read, write: if isOwner(userId);
    }

    match /handwrittenStats/{userId}/{filename} {
      allow read, write: if isOwner(userId);
    }

    match /voiceRecordings/{userId}/{filename} {
      allow read, write: if isOwner(userId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
